rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasConfirmedPayment(listingId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/payments/$(request.auth.uid + '_' + listingId)) &&
        get(/databases/$(database)/documents/payments/$(request.auth.uid + '_' + listingId)).data.status == 'confirmed';
    }

    function isVerifiedHost() {
      return isAuth() &&
        get(/databases/$(database)/documents/host_verifications/$(request.auth.uid)).data.status == 'approved';
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Students can read/write their own profile. Admin can read all.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── listings ───────────────────────────────────────────────────────────
    // Anyone can read listings. Only admin can write.
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── caretaker_contacts ─────────────────────────────────────────────────
    // Only readable after student has a confirmed payment for that listing.
    // Only admin can write.
    match /caretaker_contacts/{contactId} {
      allow read: if isAdmin() || hasConfirmedPayment(contactId);
      allow create, update, delete: if isAdmin();
    }

    // ── payments ───────────────────────────────────────────────────────────
    // Students can read their own payments.
    // Only admin can confirm/reject (update status).
    // Vercel API writes via Admin SDK (bypasses these rules).
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
// ── promo_codes ────────────────────────────────────────────────────────
    // Students can read their own promo codes. Admin can read all.
    // Client can create their own code (mirrors payments/reviews pattern),
    // but cannot redeem it — used_by only ever gets set by admin/server,
    // since /api/redeem-promo needs a trusted rebuild before any client
    // write should be able to flip that field.
    match /promo_codes/{promoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.owner_id == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.owner_id == request.auth.uid &&
        request.resource.data.used_by == null;
      allow update, delete: if isAdmin();
    }
    // ── favourites ─────────────────────────────────────────────────────────
    // Students can only read/write their own favourites.
    match /favourites/{favId} {
      allow read, write: if isAuth() &&
        resource.data.uid == request.auth.uid;
      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid;
    }

    // ── reviews ────────────────────────────────────────────────────────────
    // Anyone can read reviews. Authenticated users can create.
    // Users can only edit/delete their own reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── reports ────────────────────────────────────────────────────────────
    // Anyone authenticated can submit a report.
    // Only admin can read and manage reports.
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ── storage_hosts ──────────────────────────────────────────────────────
    // Anyone can read active host listings.
    // Only verified hosts can create/edit their own listing.
    match /storage_hosts/{hostId} {
      allow read: if true;
      allow create: if isVerifiedHost() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
        (isVerifiedHost() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── storage_seekers ────────────────────────────────────────────────────
    // Authenticated users can post and manage their own seeker requests.
    match /storage_seekers/{seekerId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
        (isAuth() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── storage_bookings ───────────────────────────────────────────────────
    // Only the seeker and admin can read a booking.
    // Created by Vercel API via Admin SDK.
    match /storage_bookings/{bookingId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.seeker_uid == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── host_verifications ─────────────────────────────────────────────────
    // Users can submit and read their own verification.
    // Only admin can approve/reject.
    match /host_verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        !exists(/databases/$(database)/documents/host_verifications/$(uid));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

  }
}
